# Nova-Mind Vercel 部署环境变量示例
# 请复制此文件的内容到 Vercel Settings → Environment Variables

# ===== 必需配置 =====

# DeepSeek API 配置（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 模型策略选择
# cost: 优先使用便宜的模型（推荐用于日常对话）
# quality: 优先使用高质量的模型
# balanced: 轮流使用不同模型
MODEL_STRATEGY=cost

# 标记为免费版本
IS_FREE_VERSION=true

# ===== 可选配置 =====

# Ollama 配置（如果在本地运行 Ollama）
# OLLAMA_ENABLED=true
# OLLAMA_ENDPOINT=http://your-machine-ip:11434
# OLLAMA_MODEL=mistral

# 月度成本预算（单位：元）
MONTHLY_COST_BUDGET=100

# 数据库连接（Vercel 会自动配置，如需自定义）
# DATABASE_URL=mysql://user:password@host:port/database

# ===== 高级配置 =====

# 启用成本监控
ENABLE_COST_TRACKING=true

# 启用护栏系统
ENABLE_GUARDRAILS=true

# 启用自动优化
ENABLE_AUTO_OPTIMIZATION=true

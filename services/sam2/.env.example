# Required for authenticated service-to-service calls
NOVA_VISION_SERVICE_TOKEN=replace-with-a-long-random-secret
# Comma-separated exact HTTPS hostnames for Nova-owned object storage
SAM2_ALLOWED_MEDIA_HOSTS=storage.example.com
SAM2_ARTIFACT_DIR=./artifacts
SAM2_MAX_MEDIA_BYTES=15728640
SAM2_MODEL_NAME=sam2.1_hiera_small
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml
SAM2_CHECKPOINT=./checkpoints/sam2.1_hiera_small.pt
# cuda or cpu; defaults to cuda when available
SAM2_DEVICE=cuda

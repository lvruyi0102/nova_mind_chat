{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "server/services/performanceHistoryService.ts", "server/services/autoCurationScheduler.ts", "server/services/bulkCurationService.ts", "server/services/simpleGenerationService.ts", "server/services/multimodalService.ts", "server/services/creativeWorkSaveService.ts", "client/src/pages/CreativeGallery.tsx", "client/src/pages/DataExport.tsx", "client/src/pages/EmotionalDialogue.tsx", "client/src/pages/VoiceChatPage.tsx", "client/src/components/CreativeCommentSection.tsx", "client/src/components/CreativeDetail.tsx", "client/src/components/CuratedThoughtsGallery.tsx", "client/src/components/FileUploadPanel.tsx"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
